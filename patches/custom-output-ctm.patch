+}
+
+void DrmTest::testCustomCtmLifecycle()
+{
+    const auto mockGpu = findPrimaryDevice(1);
+    mockGpu->deviceCaps[MOCKDRM_DEVICE_CAP_ATOMIC] = 1;
+    mockGpu->connectors.push_back(std::make_shared<MockConnector>(mockGpu.get()));
+
+    const auto session = Session::create(Session::Type::Noop);
+    const auto backend = std::make_unique<DrmBackend>(session.get());
+    const auto renderBackend = backend->createQPainterBackend();
+    auto gpu = std::make_unique<DrmGpu>(backend.get(), mockGpu->fd, DrmDevice::open(mockGpu->devNode));
+    QVERIFY(gpu->updateOutputs());
+    DrmOutput *const output = gpu->drmOutputs().front();
+
+    auto apply = std::make_shared<OutputChangeSet>();
+    apply->customSdrCtm = QMatrix4x4();
+    QVERIFY(output->queueChanges(apply));
+    output->applyQueuedChanges(apply);
+    // The hardware test-and-commit itself only runs once the pipeline has an
+    // active, presented frame (see DrmOutput::tryKmsColorOffloading's early
+    // return); testModeset notes the same harness gap. Without that, the
+    // request legitimately stays queued at Testing rather than reaching
+    // Active, exactly as it should for a matrix that has not actually been
+    // validated against real output content yet.
+    QCOMPARE(output->customSdrCtmStatus(), BackendOutput::CustomSdrCtmStatus::Testing);
+
+    auto reset = std::make_shared<OutputChangeSet>();
+    reset->customSdrCtm = std::optional<QMatrix4x4>{};
+    QVERIFY(output->queueChanges(reset));
+    output->applyQueuedChanges(reset);
+    QCOMPARE(output->customSdrCtmStatus(), BackendOutput::CustomSdrCtmStatus::Disabled);
+
+    gpu.reset();
+    verifyCleanup(mockGpu.get());
+}
